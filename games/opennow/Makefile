# Regenerate CARGO_CRATES after every version bump from the *patched*
# lockfiles, one run each, then merge and sort -u:

# make cargo-crates reads the lockfile as it is when you run it, and it doesn’t apply
# patches itself. For the list to match the patched lockfile, run make patch first,
# so Cargo.lock is patched, and then run make cargo-crates. With a stale work directory,
# run make clean patch, then the two cargo-crates commands from your comment block, then
# merge them as you’ve been doing.

# make patch
# make cargo-crates > ./streamer.txt
# make cargo-crates \
#   CARGO_CARGOLOCK=$PWD/work/OpenNOW-1.0.5/native/opennow-core/Cargo.lock \
#   CARGO_CARGOTOML=$PWD/work/OpenNOW-1.0.5/native/opennow-core/Cargo.toml > ./core.txt
# make clean patch
# cat ./streamer.txt ./core.txt \
#   | grep -E '^(CARGO_CRATES=|[[:space:]]+)[A-Za-z0-9_.+-]+-[0-9]' \
#   | sed -E 's/^CARGO_CRATES=//' | tr -s ' \t\\' '\n' | grep . | sort -u \
#   | awk 'BEGIN{printf "CARGO_CRATES=\t"} NR>1{printf " \\\n\t\t"} {printf "%s",$0} END{print ""}' > ./list.txt

# Replace contents of list.txt to CARGO_CRATES list below
# make makesum

